#!/bin/bash -l
# NCSA Campus Cluster template verified against `sinfo` on 2026-07-16.
# Submit with an explicit array, for example:
#   sbatch --array=1-30%3 drivaerml_transfer_array_ncsa.job /abs/P1_commands.txt
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus-per-node=1
#SBATCH --mem=96GB
#SBATCH --partition=IllinoisComputes-GPU
#SBATCH --time=24:00:00
#SBATCH --output=slurm-%x_%A_%a.out

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: sbatch --array=1-N%K $0 /absolute/path/to/phase_commands.txt" >&2
    exit 2
fi

command_file=$1
if [[ ! -f $command_file ]]; then
    echo "command file not found: $command_file" >&2
    exit 2
fi

command_line=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$command_file")
if [[ -z $command_line ]]; then
    echo "no command at array index ${SLURM_ARRAY_TASK_ID}" >&2
    exit 2
fi

echo "host=$(hostname) job=${SLURM_JOB_ID} array=${SLURM_ARRAY_TASK_ID}"
echo "$command_line"
srun --kill-on-bad-exit=1 bash -lc "$command_line"
