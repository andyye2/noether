#!/bin/bash -l
# Submit train-only statistics commands on CPU nodes, for example:
#   sbatch --array=1-16%4 drivaerml_statistics_array_ncsa.job /abs/statistics_commands.txt
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32GB
#SBATCH --partition=IllinoisComputes
#SBATCH --time=12:00:00
#SBATCH --output=slurm-%x_%A_%a.out

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: sbatch --array=1-N%K $0 /absolute/path/to/statistics_commands.txt" >&2
    exit 2
fi

command_file=$1
command_line=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$command_file")
if [[ -z $command_line ]]; then
    echo "no command at array index ${SLURM_ARRAY_TASK_ID}" >&2
    exit 2
fi

echo "host=$(hostname) job=${SLURM_JOB_ID} array=${SLURM_ARRAY_TASK_ID}"
echo "$command_line"
srun --kill-on-bad-exit=1 bash -lc "$command_line"
